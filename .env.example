# Aquí solo van los NOMBRES de las variables, nunca sus valores. .env.local NUNCA se sube a Git.
#
# En local no hace falta ningún archivo para arrancar: `pnpm dev` levanta el Supabase local y le pasa
# a la app su dirección y sus claves (docs/decisions/0007-supabase-local-para-desarrollo.md). Copia a
# .env.local solo lo opcional que quieras probar: la IA, el correo o los recordatorios.
#
# En producción, todas van en las variables de la aplicación en el panel de Dokploy
# (docs/deployment.md).

# --- Supabase (solo en producción: en local las pone `pnpm dev`) ---
# Panel de Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable. Viaja al navegador a propósito: todo lo que hace pasa por las reglas por filas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (service role). SE SALTA las reglas por filas: solo en el servidor y solo cuando no hay
# otra forma. Nunca con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- La app (solo en producción: en local la pone `pnpm dev`) ---
# Dirección pública de la app, para los enlaces de los correos.
NEXT_PUBLIC_SITE_URL=

# --- Correo (Resend) ---
# Clave de la API de Resend. Sin ella, en desarrollo los correos se escriben en la consola en vez de
# enviarse; en producción la app se niega a enviar. Nunca con el prefijo NEXT_PUBLIC_.
RESEND_API_KEY=
# Quién firma los correos, con el formato: Carpeta Fiscal <avisos@tudominio.es>. El dominio tiene que
# estar verificado en Resend. Si no se pone, se usa el remitente de pruebas de Resend.
EMAIL_FROM=

# --- IA (OpenRouter) ---
# Clave de la API de OpenRouter, que lee los documentos subidos. Sin ella, la app sube el documento
# igual y lo deja pendiente de revisión con los campos vacíos. Nunca con el prefijo NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Qué modelo lee los documentos, por ejemplo google/gemini-3-flash-preview.
OPENROUTER_MODEL=

# --- Trabajo diario de recordatorios ---
# Secreto que tiene que traer quien llame a /api/recordatorios. Lo genera cualquiera: una cadena larga
# y aleatoria. En el VPS lo lleva el trabajo programado de Dokploy.
CRON_SECRET=
