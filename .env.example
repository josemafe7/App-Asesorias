# Copia este archivo a .env.local y rellena los valores. .env.local NUNCA se sube a Git.
# Aquí solo van los NOMBRES de las variables, nunca sus valores.

# --- Supabase ---
# Panel de Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable. Viaja al navegador a propósito: todo lo que hace pasa por las reglas por filas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (service role). SE SALTA las reglas por filas: solo en el servidor y solo cuando no hay
# otra forma. Nunca con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- La app ---
# Dirección pública de la app, para los enlaces de los correos. En local, http://localhost:3000
NEXT_PUBLIC_SITE_URL=
